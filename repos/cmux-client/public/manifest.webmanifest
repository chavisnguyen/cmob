{
  "name": "Cmob",
  "short_name": "Cmob",
  "description": "Watch & control your coding agents from your phone. Mobile & Web companion for cmux terminal workspaces.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#141413",
